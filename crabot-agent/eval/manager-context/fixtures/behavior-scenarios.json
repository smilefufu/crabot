      "steps": [
        { "kind": "idle_review" }
      ],
      "expect": {
        "required_tools": ["inspect_workboard", "spawn_worker"],
        "required_calls": [
          { "tool": "spawn_worker", "contains": { "title": "退款回归", "prompt": "退款" } }
        ],
        "worker_spawns": { "count": 1, "workspace": "project_root" }
      }
    },
